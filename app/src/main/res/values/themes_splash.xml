<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ system splash for Compose FrontendActivity.
      White background + brand logo (same as launcher / legacy loading).
      Falls back gracefully on API < 31 via windowBackground.
    -->
    <style name="Theme.Liferych.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/liferych_app_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:statusBarColor">@color/ic_launcher_background</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
